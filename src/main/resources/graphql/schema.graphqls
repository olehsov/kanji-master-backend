"""
Kanji Master API. Read-only dictionary data (kanji, radicals, words, example sentences)
plus AI-generated grammar lessons.
"""
type Query {
    "Page of kanji, optionally filtered. `page` defaults to 0, `size` to 20 (max 100). A search term that matches nothing returns an empty page."
    getKanjis(page: Int, size: Int, filter: KanjiFilter): KanjiInfoPage!
    "Full information about one kanji, with its 15 most frequent words. NOT_FOUND error if it does not exist."
    getKanji(kanji: String): KanjiInfo!
    "All radicals and radical variants usable in the radical search, ordered by stroke count."
    getRadicalSearchOptionDto: [RadicalSearchOption]
    "Kanji that contain ALL of the given radicals (matched against `elements`)."
    getKanjiesByRadical(radicals: [String]): [KanjiInfo]
    "Example sentences whose `word` contains the given kanji. `page` defaults to 0, `size` to 20 (max 100)."
    getSentencesByKanji(page: Int, size: Int, kanji: String): SentencePage!
    "All grammar topics."
    getAllTopics: [Topic]!
    """
    Lesson for a grammar topic: formation, examples and exercises. Generated by the active AI provider
    (`kanji.ai.provider`); the default `stub` provider always returns the same demo lesson.
    Each task type may appear once with `taskAmount` 0..20; an empty list returns a lesson without exercises.
    """
    getTopicTask(topicId: Int, settings: [GrammarSettingPayload]): GrammarTopic!
}

"Filter for kanji lists and the PDF endpoint. Empty lists mean no constraint."
input KanjiFilter {
    "Reading in kana or romaji (matched against the SEARCH table)."
    search: String
    "Grades exactly as stored, e.g. \"Kyōiku-Jōyō (1st grade of primary school)\"."
    grade: [String]
    "JLPT levels exactly as stored, e.g. \"N5 (beginner)\"."
    jlpt: [String]
}

"Kanji dictionary entry."
type KanjiInfo {
    kanji: String!
    "Classical radical."
    radical: String!
    "Radical variant as written inside this kanji."
    radvar: String!
    type: String!
    "Regular (jouyou) on'yomi readings."
    regularOn: String!
    "Regular (jouyou) kun'yomi readings."
    regularKun: String!
    onyomi: String!
    kunyomi: String!
    "Name readings."
    nanori: String!
    strokes: Int
    grade: String
    jlpt: String
    "Kanji Kentei level."
    kanken: String!
    "Newspaper frequency rank (lower = more common)."
    frequency: Int
    "Meanings separated by ';'."
    meaning: String!
    compactMeaning: String!
    "Components (radicals) this kanji is built from."
    elements: String!
    kanjiParts: String!
    "Kanji that contain this kanji as a part."
    partOf: String!
    "Words containing this kanji, most frequent first."
    words: [Word!]!
}

"Dictionary word."
type Word {
    id: ID!
    word: String
    "Reading in kana."
    yomiDisplay: String
    romajiDisplay: String
    freq: Int
    isSelfSupporting: Boolean
    "Ukrainian translation."
    translation: String
}

"Example sentence."
type Sentence {
    id: Int!
    japanese: String!
    english: String!
    particle: String!
    word: String!
    kanji: String!
    furigana: String!
    obi2: String!
}

type SentencePage {
    content: [Sentence]
    totalPages: Int
    totalElements: Int
    last: Boolean
    size: Int
    number: Int
    numberOfElements: Int
    first: Boolean
}

type KanjiInfoPage {
    content: [KanjiInfo]
    totalPages: Int
    totalElements: Int
    last: Boolean
    size: Int
    number: Int
    numberOfElements: Int
    first: Boolean
}

"Radical (or radical variant) shown in the radical search picker."
type RadicalSearchOption {
    radical: String!
    strokes: Int!
    "True for a variant form (radvar), false for the classical radical."
    isSimplifiedRadical: Boolean!
}

"Grammar topic, e.g. te-form or passive voice."
type Topic {
    id: ID!
    header: String!
    description: String!
}

"AI-generated grammar lesson. Explanations and translations are in Ukrainian."
type GrammarTopic {
    header: String
    "How the grammar is formed (HTML)."
    formation: String
    exampleSentences: [ExampleSentence!]!
    tasks: [Task!]!
}

type ExampleSentence {
    sentence: String!
    translation: String!
}

"Exercise with its expected answer."
type Task {
    taskType: TaskType!
    description: String!
    question: String!
    correctAnswer: String!
    resources: [String!]!
}

enum TaskType {
    "Convert a word into the grammar form."
    CONVERT_TO_FORMATION
    "Translate a sentence into Japanese."
    TRANSLATE_TO_JAPANESE
    "Fill the blank in a sentence."
    FILL_IN_THE_BLANKS
}

"How many tasks of one type to generate."
input GrammarSettingPayload {
    type: TaskType
    "0..20"
    taskAmount: Int
}
